<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
<title>Protege – History</title>
<style>
  @font-face { font-family:'Syne'; src:url('fonts/Syne-ExtraBold.ttf') format('truetype'); font-weight:800; font-display:swap; }
  @font-face { font-family:'Syne'; src:url('fonts/Syne-Bold.ttf') format('truetype'); font-weight:700; font-display:swap; }
  @font-face { font-family:'DM Sans'; src:url('fonts/DMSans-Regular.ttf') format('truetype'); font-weight:400; font-display:swap; }
  @font-face { font-family:'DM Sans'; src:url('fonts/DMSans-Medium.ttf') format('truetype'); font-weight:500; font-display:swap; }

  *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
  :root {
    --bg:#0a0a0f; --accent:#6c63ff; --accent2:#00d4aa;
    --text:#f0f0f8; --muted:#6b6b80; --border:rgba(255,255,255,0.08);
    --card:rgba(255,255,255,0.04); --error:#ff5e7e; --gold:#f7c948;
  }
  html,body { min-height:100%; width:100%; overflow-x:hidden; overflow-y:auto; background:var(--bg); color:var(--text); font-family:'DM Sans',-apple-system,sans-serif; -webkit-font-smoothing:antialiased; }

  .orbs { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .orb { position:absolute; border-radius:50%; filter:blur(80px); opacity:0.1; animation:drift 8s ease-in-out infinite alternate; }
  .orb1 { width:260px; height:260px; background:var(--accent); top:-60px; right:-60px; }
  .orb2 { width:180px; height:180px; background:var(--accent2); bottom:80px; left:-40px; animation-delay:-4s; }
  @keyframes drift { from{transform:translate(0,0)} to{transform:translate(12px,20px)} }

  .page { position:relative; z-index:1; display:flex; flex-direction:column; padding:0 20px 60px; }

  .header { display:flex; align-items:center; padding:52px 0 20px; gap:12px; }
  .back-btn { width:40px; height:40px; border-radius:12px; background:var(--card); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; text-decoration:none; transition:background 0.2s; }
  .back-btn:active { background:rgba(255,255,255,0.1); }
  .header-title { font-family:'Syne',-apple-system,sans-serif; font-size:22px; font-weight:800; letter-spacing:-0.02em; flex:1; }

  /* Summary strip */
  .summary-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:20px; }
  .summary-card { background:var(--card); border:1px solid var(--border); border-radius:16px; padding:14px; text-align:center; }
  .summary-val { font-family:'Syne',sans-serif; font-size:18px; font-weight:800; margin-bottom:4px; }
  .summary-val.green { color:var(--accent2); }
  .summary-val.red { color:var(--error); }
  .summary-val.gold { color:var(--gold); }
  .summary-lbl { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.05em; }

  /* Filter tabs */
  .filter-tabs { display:flex; gap:8px; margin-bottom:20px; overflow-x:auto; padding-bottom:2px; scrollbar-width:none; }
  .filter-tabs::-webkit-scrollbar { display:none; }
  .filter-tab { flex-shrink:0; padding:9px 16px; border-radius:12px; background:var(--card); border:1px solid var(--border); font-size:13px; font-weight:500; color:var(--muted); cursor:pointer; transition:all 0.2s; white-space:nowrap; }
  .filter-tab.active { background:rgba(108,99,255,0.15); border-color:rgba(108,99,255,0.35); color:var(--text); font-weight:600; }
  .filter-tab:active { transform:scale(0.96); }

  /* Loading skeleton */
  .skeleton { background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; border-radius:14px; }
  @keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
  .skeleton-item { height:72px; margin-bottom:10px; }

  /* Date separator */
  .date-sep { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.08em; padding:16px 0 8px; }

  /* Transaction item */
  .tx-item { display:flex; align-items:center; gap:14px; padding:16px; background:var(--card); border:1px solid var(--border); border-radius:16px; margin-bottom:10px; animation:fadeUp 0.3s ease; cursor:pointer; transition:border-color 0.15s; }
  .tx-item:active { border-color:var(--accent); }
  @keyframes fadeUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
  .tx-icon { width:42px; height:42px; border-radius:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .tx-icon.credit { background:rgba(0,212,170,0.1); }
  .tx-icon.debit { background:rgba(255,94,126,0.1); }
  .tx-icon.pending-icon { background:rgba(247,201,72,0.1); }
  .tx-info { flex:1; min-width:0; }
  .tx-label { font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tx-sub { font-size:12px; color:var(--muted); margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tx-right { text-align:right; flex-shrink:0; }
  .tx-amount { font-family:'Syne',sans-serif; font-size:16px; font-weight:700; }
  .tx-amount.credit { color:var(--accent2); }
  .tx-amount.debit { color:var(--error); }
  .tx-time { font-size:11px; color:var(--muted); margin-top:3px; }
  .tx-badge { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px; display:inline-block; margin-top:4px; }
  .tx-badge.pending { background:rgba(247,201,72,0.12); color:var(--gold); }
  .tx-badge.completed { background:rgba(0,212,170,0.1); color:var(--accent2); }
  .tx-badge.rejected { background:rgba(255,94,126,0.1); color:var(--error); }

  /* Transfer back button */
  .tx-transfer-back { display:flex; align-items:center; gap:4px; margin-top:6px; font-size:11px; font-weight:600; color:var(--accent); background:rgba(108,99,255,0.1); border:1px solid rgba(108,99,255,0.2); border-radius:8px; padding:4px 10px; cursor:pointer; width:fit-content; transition:background 0.15s; }
  .tx-transfer-back:active { background:rgba(108,99,255,0.2); }

  /* Empty state */
  .tx-empty { text-align:center; padding:48px 20px; color:var(--muted); }
  .tx-empty-icon { margin-bottom:14px; opacity:0.3; }

  /* Detail modal */
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:200; display:none; align-items:flex-end; backdrop-filter:blur(6px); }
  .modal-overlay.open { display:flex; }
  .modal-sheet { width:100%; background:#111118; border-radius:28px 28px 0 0; border:1px solid var(--border); border-bottom:none; padding:0 24px 48px; animation:slideUp 0.35s cubic-bezier(0.34,1.2,0.64,1); }
  @keyframes slideUp { from{transform:translateY(100%)} to{transform:translateY(0)} }
  .modal-handle { width:40px; height:4px; background:var(--border); border-radius:2px; margin:12px auto 24px; }

  .detail-icon-big { width:64px; height:64px; border-radius:20px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
  .detail-amount { font-family:'Syne',sans-serif; font-size:36px; font-weight:800; text-align:center; margin-bottom:4px; }
  .detail-amount.credit { color:var(--accent2); }
  .detail-amount.debit { color:var(--error); }
  .detail-label { font-size:14px; color:var(--muted); text-align:center; margin-bottom:24px; }
  .detail-rows { background:var(--card); border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-bottom:16px; }
  .detail-row { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--border); }
  .detail-row:last-child { border-bottom:none; }
  .detail-row-label { font-size:13px; color:var(--muted); }
  .detail-row-val { font-size:13px; font-weight:600; text-align:right; max-width:60%; word-break:break-all; }

  .btn-ghost { width:100%; padding:16px; border-radius:14px; background:var(--card); border:1px solid var(--border); color:var(--muted); font-family:inherit; font-size:14px; font-weight:600; cursor:pointer; }

  /* Toast */
  .toast { position:fixed; bottom:32px; left:50%; transform:translateX(-50%) translateY(80px); background:#1e1e2e; border:1px solid var(--border); border-radius:12px; padding:12px 20px; font-size:14px; font-weight:500; display:flex; align-items:center; gap:8px; z-index:999; transition:transform 0.3s cubic-bezier(0.34,1.3,0.64,1); white-space:nowrap; box-shadow:0 8px 32px rgba(0,0,0,0.4); }
  .toast.show { transform:translateX(-50%) translateY(0); }
  .toast.success { border-color:rgba(0,212,170,0.3); color:var(--accent2); }
  .toast.info { border-color:rgba(108,99,255,0.3); color:var(--accent); }
</style>
</head>
<body>
<div class="orbs"><div class="orb orb1"></div><div class="orb orb2"></div></div>
<div class="toast" id="toast"></div>

<!-- Detail modal -->
<div class="modal-overlay" id="detailModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="detail-icon-big" id="detailIcon"></div>
    <div class="detail-amount" id="detailAmount"></div>
    <div class="detail-label" id="detailLabel"></div>
    <div class="detail-rows" id="detailRows"></div>
    <button class="btn-ghost" onclick="closeModal()">Close</button>
  </div>
</div>

<div class="page">
  <div class="header">
    <a href="withdrawal.html" class="back-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f0f0f8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    </a>
    <div class="header-title">Transaction History</div>
  </div>

  <!-- Summary -->
  <div class="summary-strip">
    <div class="summary-card">
      <div class="summary-val green" id="sumReceived">$0.00</div>
      <div class="summary-lbl">Received</div>
    </div>
    <div class="summary-card">
      <div class="summary-val red" id="sumSent">$0.00</div>
      <div class="summary-lbl">Sent</div>
    </div>
    <div class="summary-card">
      <div class="summary-val gold" id="sumPending">$0.00</div>
      <div class="summary-lbl">Pending</div>
    </div>
  </div>

  <!-- Filters -->
  <div class="filter-tabs">
    <div class="filter-tab active" id="ft_all" onclick="setFilter('all')">All</div>
    <div class="filter-tab" id="ft_received" onclick="setFilter('received')">Received</div>
    <div class="filter-tab" id="ft_sent" onclick="setFilter('sent')">Sent</div>
    <div class="filter-tab" id="ft_withdraw" onclick="setFilter('withdraw')">Withdrawals</div>
  </div>

  <!-- List -->
  <div id="txList">
    <div class="skeleton skeleton-item"></div>
    <div class="skeleton skeleton-item"></div>
    <div class="skeleton skeleton-item"></div>
    <div class="skeleton skeleton-item"></div>
  </div>
</div>

<script>
const API = 'https://sample-api-1-ryj7.onrender.com';
let allTx = [], allWd = [];
let currentFilter = 'all';
let selectedTx = null;

async function loadAll() {
  const token = localStorage.getItem('protege_token');
  if (!token) { window.location.href = 'login.html'; return; }

  try {
    const [txRes, wdRes] = await Promise.all([
      fetch(`${API}/api/transactions?filter=all&limit=100`, { headers: { 'Authorization': `Bearer ${token}` } }),
      fetch(`${API}/api/withdrawals`, { headers: { 'Authorization': `Bearer ${token}` } })
    ]);
    const txData = await txRes.json();
    const wdData = await wdRes.json();

    allTx = txData.success ? txData.transactions : [];
    allWd = wdData.success ? wdData.withdrawals : [];

    calcSummary();
    renderList('all');
  } catch(e) {
    document.getElementById('txList').innerHTML = '<div class="tx-empty">Failed to load. Pull to refresh.</div>';
  }
}

function calcSummary() {
  let received = 0, sent = 0, pending = 0;
  allTx.forEach(t => {
    const amt = parseFloat(t.amount);
    if (amt > 0) received += amt;
    else sent += Math.abs(amt);
  });
  allWd.forEach(w => { if (w.status === 'pending') pending += parseFloat(w.amount); });
  document.getElementById('sumReceived').textContent = `$${received.toFixed(2)}`;
  document.getElementById('sumSent').textContent = `$${sent.toFixed(2)}`;
  document.getElementById('sumPending').textContent = `$${pending.toFixed(2)}`;
}

function setFilter(f) {
  currentFilter = f;
  document.querySelectorAll('.filter-tab').forEach(el => el.classList.remove('active'));
  document.getElementById(`ft_${f}`).classList.add('active');
  renderList(f);
}

function renderList(filter) {
  let list = [...allTx];

  if (filter === 'received') list = list.filter(t => parseFloat(t.amount) > 0);
  else if (filter === 'sent') list = list.filter(t => parseFloat(t.amount) < 0);
  else if (filter === 'withdraw') list = list.filter(t => t.type === 'withdraw');

  // Merge withdrawal requests status for withdraw type
  const wdMap = {};
  allWd.forEach(w => { wdMap[w.id] = w; });

  if (list.length === 0) {
    document.getElementById('txList').innerHTML = `
      <div class="tx-empty">
        <div class="tx-empty-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
        No ${filter === 'all' ? '' : filter} transactions yet
      </div>`;
    return;
  }

  // Group by date
  const groups = {};
  list.forEach(t => {
    const d = new Date(t.created_at);
    const today = new Date();
    const yesterday = new Date(today); yesterday.setDate(today.getDate()-1);
    let key;
    if (d.toDateString() === today.toDateString()) key = 'Today';
    else if (d.toDateString() === yesterday.toDateString()) key = 'Yesterday';
    else key = d.toLocaleDateString([], { weekday:'long', day:'numeric', month:'long' });
    if (!groups[key]) groups[key] = [];
    groups[key].push(t);
  });

  let html = '';
  Object.entries(groups).forEach(([date, items]) => {
    html += `<div class="date-sep">${date}</div>`;
    items.forEach(t => { html += buildTxItem(t); });
  });

  document.getElementById('txList').innerHTML = html;
}

function buildTxItem(t) {
  const amt = parseFloat(t.amount);
  const isCredit = amt > 0;
  const absAmt = Math.abs(amt).toFixed(2);
  const time = new Date(t.created_at).toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });
  const desc = t.description || '';

  let label = '', sub = '', iconHtml = '', iconClass = '', badge = '', transferBackBtn = '';

  if (t.type === 'referral_bonus') {
    label = 'Referral Bonus';
    sub = 'Friend joined with your code';
    iconClass = 'credit';
    iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
  } else if (t.type === 'signup_bonus') {
    label = 'Welcome Bonus';
    sub = 'Joined with a referral code';
    iconClass = 'credit';
    iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
  } else if (t.type === 'withdraw') {
    label = 'Withdrawal';
    sub = desc.replace('Withdrawal via ', '').replace(' — pending', '');
    iconClass = 'pending-icon';
    iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`;
    badge = `<span class="tx-badge pending">Pending</span>`;
  } else if (t.type === 'transfer') {
    // Parse name|phone from description
    const parts = desc.split('|');
    const otherName = parts[0].replace('Transfer to ','').replace('Transfer from ','');
    const otherPhone = parts[1] || '';

    if (isCredit) {
      label = `Received from ${otherName}`;
      sub = otherPhone;
      iconClass = 'credit';
      iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>`;
      // Transfer back button
      if (otherPhone) {
        transferBackBtn = `<div class="tx-transfer-back" onclick="event.stopPropagation();transferBack('${otherPhone}','${otherName}')">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          Send back
        </div>`;
      }
    } else {
      label = `Sent to ${otherName}`;
      sub = otherPhone;
      iconClass = 'debit';
      iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--error)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;
    }
  } else {
    label = t.type || 'Transaction';
    sub = desc;
    iconClass = isCredit ? 'credit' : 'debit';
    iconHtml = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${isCredit ? 'var(--accent2)' : 'var(--error)'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg>`;
  }

  return `
    <div class="tx-item" onclick="showDetail('${t.id}')">
      <div class="tx-icon ${iconClass}">${iconHtml}</div>
      <div class="tx-info">
        <div class="tx-label">${label}</div>
        <div class="tx-sub">${sub}</div>
        ${badge}
        ${transferBackBtn}
      </div>
      <div class="tx-right">
        <div class="tx-amount ${isCredit ? 'credit' : 'debit'}">${isCredit ? '+' : '-'}$${absAmt}</div>
        <div class="tx-time">${time}</div>
      </div>
    </div>`;
}

function transferBack(phone, name) {
  window.location.href = `transfer.html?phone=${encodeURIComponent(phone)}`;
}

function showDetail(id) {
  const t = allTx.find(tx => tx.id === id);
  if (!t) return;
  selectedTx = t;

  const amt = parseFloat(t.amount);
  const isCredit = amt > 0;
  const absAmt = Math.abs(amt).toFixed(2);
  const date = new Date(t.created_at).toLocaleString([], { dateStyle:'medium', timeStyle:'short' });
  const desc = t.description || '';

  // Icon
  const iconBg = isCredit ? 'rgba(0,212,170,0.1)' : 'rgba(255,94,126,0.1)';
  document.getElementById('detailIcon').style.background = iconBg;
  document.getElementById('detailIcon').innerHTML = isCredit
    ? `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>`
    : `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--error)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;

  document.getElementById('detailAmount').className = `detail-amount ${isCredit ? 'credit' : 'debit'}`;
  document.getElementById('detailAmount').textContent = `${isCredit ? '+' : '-'}$${absAmt}`;
  document.getElementById('detailLabel').textContent = t.type.replace(/_/g,' ').toUpperCase();

  document.getElementById('detailRows').innerHTML = `
    <div class="detail-row"><span class="detail-row-label">Type</span><span class="detail-row-val">${t.type.replace(/_/g,' ')}</span></div>
    <div class="detail-row"><span class="detail-row-label">Description</span><span class="detail-row-val">${desc.replace('|','\n').replace(/Transfer (to|from) /,'')}</span></div>
    <div class="detail-row"><span class="detail-row-label">Date & Time</span><span class="detail-row-val">${date}</span></div>
    <div class="detail-row"><span class="detail-row-label">Reference</span><span class="detail-row-val" style="font-size:11px;color:var(--muted)">${t.id.slice(0,18).toUpperCase()}</span></div>
  `;

  document.getElementById('detailModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  document.getElementById('detailModal').classList.remove('open');
  document.body.style.overflow = '';
}

document.getElementById('detailModal').addEventListener('click', e => {
  if (e.target === document.getElementById('detailModal')) closeModal();
});

function showToast(msg, type='info') {
  const t = document.getElementById('toast');
  t.className = `toast ${type} show`;
  t.innerHTML = msg;
  setTimeout(() => t.classList.remove('show'), 3000);
}

window.addEventListener('load', loadAll);
</script>
</body>
</html>

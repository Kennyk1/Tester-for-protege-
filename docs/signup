let selectedDial = "+1";
let filteredCountries = [...COUNTRIES];

function renderCountries(list) {
  const el = document.getElementById('countryList');
  el.innerHTML = list.map(c => `
    <div class="country-item" onclick="selectCountry('${c.code}','${c.flag}')">
      <span class="country-name">${c.flag} ${c.name}</span>
      <span class="country-code">${c.code}</span>
    </div>
  `).join('');
}

function openCountry() {
  renderCountries(COUNTRIES);
  document.getElementById('countryDropdown').classList.add('open');
  document.getElementById('overlay').classList.add('open');
  setTimeout(() => document.getElementById('countrySearch').focus(), 100);
}

function closeCountry() {
  document.getElementById('countryDropdown').classList.remove('open');
  document.getElementById('overlay').classList.remove('open');
  document.getElementById('countrySearch').value = '';
}

function selectCountry(code, flag) {
  selectedDial = code;
  document.getElementById('dialFlag').textContent = flag;
  document.getElementById('dialCode').textContent = code;
  closeCountry();
}

function filterCountries(q) {
  const filtered = COUNTRIES.filter(c =>
    c.name.toLowerCase().includes(q.toLowerCase()) || c.code.includes(q)
  );
  renderCountries(filtered);
}

// ── Toggle password visibility ──
function togglePass(inputId, iconId) {
  const input = document.getElementById(inputId);
  const icon = document.getElementById(iconId);
  const isHidden = input.type === 'password';
  input.type = isHidden ? 'text' : 'password';
  icon.innerHTML = isHidden
    ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>`
    : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
}

// ── Toggle referral ──
let refOpen = false;
function toggleReferral() {
  refOpen = !refOpen;
  document.getElementById('referralField').classList.toggle('open', refOpen);
  document.getElementById('refToggleText').textContent = refOpen ? 'Remove referral code' : 'Have a referral code? Tap to enter';

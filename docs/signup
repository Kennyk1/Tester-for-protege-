// ── Show message ──
function showMsg(type, text) {
  const el = document.getElementById('msg');
  el.className = `msg ${type}`;
  el.innerHTML = type === 'error'
    ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${text}`
    : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>${text}`;
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ── Get device ID ──
function getDeviceId() {
  let id = localStorage.getItem('protege_device_id');
  if (!id) {
    id = 'dev_' + Math.random().toString(36).substr(2,12) + Date.now().toString(36);
    localStorage.setItem('protege_device_id', id);
  }
  return id;
}

// ── Signup ──
async function doSignup() {
  const name = document.getElementById('name').value.trim();
  const phone = selectedDial + document.getElementById('phone').value.trim();
  const password = document.getElementById('password').value;
  const confirm = document.getElementById('confirm').value;
  const referral = document.getElementById('referral').value.trim().toUpperCase();

  // Validate
  if (!name) return showMsg('error', 'Please enter your full name');
  if (document.getElementById('phone').value.trim().length < 6) return showMsg('error', 'Enter a valid phone number');
  if (password.length < 8) return showMsg('error', 'Password must be at least 8 characters');
  if (password !== confirm) return showMsg('error', 'Passwords do not match');

  // Loading state
  document.getElementById('submitBtn').disabled = true;
  document.getElementById('btnText').textContent = 'Creating account...';
  document.getElementById('spinner').style.display = 'block';
  document.getElementById('btnArrow').style.display = 'none';

  try {
    const res = await fetch('https://YOUR_BACKEND_URL/api/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name,
        phone,
        password,
        referral: referral || undefined,
        device_id: getDeviceId()
      })
    });

    const data = await res.json();

    if (data.success) {
      localStorage.setItem('protege_token', data.token);
      showMsg('success', data.bonus_applied ? '🎉 Account created + bonus applied!' : 'Account created successfully!');
      setTimeout(() => { window.location.href = 'dashboard.html'; }, 1200);
    } else {
      showMsg('error', data.message || 'Signup failed. Please try again.');
      resetBtn();
    }
  } catch (e) {
    showMsg('error', 'Connection error. Check your internet and try again.');
    resetBtn();
  }
}

function resetBtn() {
  document.getElementById('submitBtn').disabled = false;
  document.getElementById('btnText').textContent = 'Create Account';
  document.getElementById('spinner').style.display = 'none';
  document.getElementById('btnArrow').style.display = 'block';
}
</script>
